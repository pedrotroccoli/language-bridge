<% content_for :title, "Authorize CLI" %>

<div class="mx-auto w-full max-w-[520px] px-6 py-14">
  <div class="bg-surface border border-line rounded-[16px] shadow-[0_1px_2px_rgba(15,23,42,.04),0_12px_32px_-12px_rgba(15,23,42,.12)] overflow-hidden">

    <% if @invalid %>
      <div class="px-7 py-7">
        <div class="flex items-center gap-[13px] mb-5">
          <div class="w-[44px] h-[44px] rounded-[11px] bg-ink flex items-center justify-center flex-none"><%= mi "terminal", size: 23, css: "text-line" %></div>
          <h1 class="m-0 text-[18px] font-semibold tracking-[-0.02em] text-ink">Authorize the Language Bridge CLI</h1>
        </div>
        <div class="border border-danger-border bg-danger-soft rounded-[9px] px-4 py-3 text-[13px] text-danger-ink">
          Invalid request: the callback address must be a local loopback URL. Re-run <span class="font-mono">lb login</span>.
        </div>
      </div>
    <% else %>
      <div class="px-7 pt-[26px] pb-[22px] border-b border-line-3">
        <div class="flex items-center gap-[13px]">
          <div class="w-[44px] h-[44px] rounded-[11px] bg-ink flex items-center justify-center flex-none"><%= mi "terminal", size: 23, css: "text-line" %></div>
          <div class="min-w-0">
            <h1 class="m-0 text-[18px] font-semibold tracking-[-0.02em] text-ink">Authorize the Language Bridge CLI</h1>
            <div class="text-[13px] text-mut mt-[3px]">A device is asking to act on your behalf.</div>
          </div>
        </div>

        <% if @verification_code %>
          <div class="flex items-center gap-3 mt-5 px-[15px] py-[13px] bg-surface-2 border border-line rounded-[10px]">
            <%= mi "key", size: 20, css: "text-mut flex-none" %>
            <div class="flex-1 min-w-0">
              <div class="font-mono text-[10.5px] tracking-[0.07em] uppercase text-mut">Verification code</div>
              <div class="font-mono text-[19px] font-semibold tracking-[0.14em] text-ink mt-[3px]"><%= @verification_code %></div>
            </div>
            <div class="text-[12px] text-mut text-right leading-[1.5] flex-none">Must match<br>your terminal</div>
          </div>
        <% end %>
      </div>

      <div class="px-7 pt-[22px]">
        <div class="font-mono text-[10.5px] tracking-[0.07em] uppercase text-mut mb-3">Requesting device</div>
        <div class="grid grid-cols-[104px_1fr] gap-x-[14px] gap-y-[9px] text-[13px]">
          <span class="text-mut">Machine</span><span class="text-ink font-mono text-[12.5px]"><%= @name %></span>
          <span class="text-mut">Account</span>
          <span class="flex items-center gap-[7px] text-ink">
            <span class="w-[19px] h-[19px] rounded-full bg-accent-soft text-accent flex items-center justify-center font-mono text-[8.5px] font-semibold"><%= current_user.email.first(2).upcase %></span>
            <%= current_user.email %>
          </span>
        </div>
      </div>

      <% # Consent wording per capability; anything the catalog gains before
         # this page learns about it falls back to the shared short label
         # rather than a blank row next to a checkmark.
         capability_rows = {
           "read"        => "Read published translations",
           "read_drafts" => "Read unpublished drafts",
           "write"       => "Push translations as unpublished drafts",
           "admin"       => "Administer projects and settings"
         } %>
      <div class="px-7 pt-[22px] pb-1">
        <div class="font-mono text-[10.5px] tracking-[0.07em] uppercase text-mut mb-3">This will let the CLI</div>
        <div class="flex flex-col gap-[11px]">
          <% @scopes.each do |capability| %>
            <div class="flex items-center gap-[11px]">
              <%= mi "check", size: 17, weight: 500, css: "text-ok flex-none" %>
              <div class="text-[13px] text-ink font-medium"><%= capability_rows.fetch(capability) { capability_label(capability) } %></div>
            </div>
          <% end %>
        </div>

        <div class="font-mono text-[10.5px] tracking-[0.07em] uppercase text-mut mt-5 mb-3">It will never be able to</div>
        <div class="flex flex-col gap-[11px]">
          <% # Publishing has no API endpoint by design; the rest comes from
             # the controller's @denied_scopes.
             denied_rows = [ "Publish translations to production" ] +
               @denied_scopes.map { |capability| capability_rows.fetch(capability) { capability_label(capability) } } %>
          <% denied_rows.each do |label| %>
            <div class="flex items-center gap-[11px]">
              <%= mi "block", size: 17, css: "text-faint-2 flex-none" %>
              <div class="text-[13px] text-ink-2"><%= label %></div>
            </div>
          <% end %>
        </div>

        <div class="text-[12.5px] text-mut mt-4 pt-[14px] leading-[1.55] border-t border-line-3">Everything pushed from the CLI lands as an <b class="font-semibold text-ink">unpublished draft</b> and still goes through review before it reaches production.</div>
        <div class="flex items-center gap-[10px] mt-[14px] px-4 py-3 bg-banner-bg border border-banner-border rounded-[10px] text-[12.5px] text-banner-ink leading-[1.5]">
          <%= mi "schedule", size: 17, css: "flex-none" %>
          <span>This request expires in <b class="font-semibold"><%= distance_of_time_in_words(CliAuthCode::TTL) %></b>. Only approve it if you just ran <span class="font-mono">lb login</span> on this machine.</span>
        </div>
      </div>

      <%# turbo: false — both outcomes redirect to the CLI's loopback
          (http://127.0.0.1:<port>), a cross-origin target Turbo's fetch can't
          follow: the submit would silently stall on this page. A full-page
          navigation follows the redirect natively. %>
      <%= form_with url: cli_authorization_path, method: :post, data: { turbo: false }, class: "flex gap-[10px] px-7 pt-[22px] pb-[26px]" do |form| %>
        <%= form.hidden_field :redirect_uri, value: @redirect_uri %>
        <%= form.hidden_field :state, value: @state %>
        <%= form.hidden_field :name, value: @name %>
        <% @scopes.each do |scope| %><%= hidden_field_tag "scopes[]", scope %><% end %>
        <%= link_to "Reject", cli_authorization_rejection_path(redirect_uri: @redirect_uri, state: @state), data: { turbo: false }, class: "btn-secondary no-underline flex-1 h-[42px] text-[13.5px] rounded-[9px]" %>
        <%= form.button class: "btn flex-1 h-[42px] text-[13.5px] rounded-[9px]" do %>
          <%= mi "check", size: 17 %>Authorize
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
