# Monorepo root ignores. The Rails app keeps its own server/.gitignore; the CLI
# keeps cli/.gitignore. Rules here cover root-level and cross-cutting artifacts.

# Local env at the repo root (compose reads it).
/.env
/.env.*
!/.env.example

# Node / CLI build output (belt-and-suspenders; cli/ has its own too).
/cli/node_modules/
/cli/dist/

# Tooling scratch.
/.gstack/
