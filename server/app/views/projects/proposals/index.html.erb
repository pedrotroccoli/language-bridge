<% content_for :title, "Proposals · #{@project.name}" %>
<% content_for :main_class, "flex-1 w-full flex flex-col min-h-0" %>

<%= render "projects/tabs", project: @project, active: :proposals %>

<div class="mx-auto w-full max-w-[1320px] px-6 py-7">
  <div>

    <%# ---- Header ---- %>
    <div class="flex items-start justify-between gap-6 mb-[6px]">
      <div class="flex items-baseline gap-[11px]">
        <h2 class="m-0 text-[19px] font-semibold -tracking-[0.02em] text-ink">Proposals</h2>
        <span class="font-mono text-[12px] text-mut"><%= @proposals.size %> pending</span>
      </div>
      <span class="inline-flex items-center gap-[6px] font-mono text-[11px] text-ink-2 bg-line-3 rounded-[6px] px-[10px] py-[5px]">
        <span class="w-[6px] h-[6px] rounded-full bg-ok"></span>lb push · staged
      </span>
    </div>
    <p class="m-0 mb-4 text-[13px] text-mut max-w-[620px] leading-[1.5]">Source-locale values pushed by an AI or the CLI via <span class="font-mono text-ink-2">lb push</span>. Nothing is live — accept to save as a draft (then publish), or reject.</p>

    <div class="flex items-center gap-[10px] px-[14px] py-[11px] border border-line rounded-[9px] bg-surface-2 mb-[18px] font-mono text-[12px] text-ink-2 overflow-x-auto">
      <span class="text-ok font-semibold">POST</span>
      <span class="text-ink">/api/v1/projects/<%= @project.slug %>/import</span>
      <span class="text-faint">{ locale, namespaces }</span>
    </div>

    <% if @proposals.any? %>
      <% @proposals.group_by(&:session).each do |session, proposals| %>
      <div class="border border-line rounded-[11px] overflow-hidden mb-[14px] last:mb-0">
        <div class="flex items-center gap-[8px] px-[18px] py-[10px] bg-surface-2 border-b border-line">
          <%= mi "commit", size: 14, css: "text-faint" %>
          <span class="font-mono text-[12px] text-ink font-semibold"><%= session.presence || "unscoped" %></span>
          <span class="font-mono text-[11px] text-faint"><%= proposals.size %> proposal<%= "s" unless proposals.size == 1 %></span>
        </div>
        <div class="flex items-center px-[18px] py-[9px] bg-surface-2 border-b border-line font-mono text-[11px] tracking-[0.05em] uppercase text-faint">
          <div class="flex-1 min-w-0">Key</div>
          <div class="w-[300px] flex-none">Change</div>
          <div class="w-[110px] flex-none">Proposer</div>
          <div class="w-[188px] flex-none text-right">Actions</div>
        </div>
        <% proposals.each do |proposal| %>
          <div class="flex items-center px-[18px] py-[13px] border-b border-line-3 last:border-b-0 hover:bg-surface-2">
            <div class="flex-1 min-w-0 flex items-center gap-[11px]">
              <span class="w-[8px] h-[8px] rounded-full border-[1.5px] border-faint-2 flex-none"></span>
              <div class="min-w-0">
                <div class="font-mono text-[13px] text-ink break-all leading-[1.5]"><%= proposal.key %></div>
                <div class="flex items-center gap-[6px] font-mono text-[11px] text-faint mt-[2px]">
                  <%= mi "folder", size: 13 %><%= proposal.namespace.name %>
                  <span class="text-faint-2">·</span><%= proposal.locale.code %>
                  <% if proposal.new_key? %><span class="ml-[3px] text-accent">new key</span><% end %>
                </div>
              </div>
            </div>
            <div class="w-[300px] flex-none min-w-0 font-mono text-[12px] leading-[1.5]">
              <% if proposal.current_value.present? %>
                <div class="text-mut line-through truncate"><%= proposal.current_value %></div>
              <% end %>
              <div class="text-ink truncate"><%= proposal.value %></div>
            </div>
            <div class="w-[110px] flex-none font-mono text-[12px] text-ink-2 truncate"><%= proposal.author.name.presence || proposal.author.email %></div>
            <div class="w-[188px] flex-none flex items-center justify-end gap-[7px]">
              <% if current_user.can_edit_translations?(@project) %>
                <%= button_to project_proposal_path(@project, proposal), method: :delete, class: "btn-secondary", form_class: "inline",
                      data: { turbo_confirm: "Reject \"#{proposal.key}\"?" } do %>Reject<% end %>
                <%= button_to project_proposal_acceptance_path(@project, proposal), method: :post, class: "btn-secondary", form_class: "inline" do %>
                  <%= mi "check", size: 15, css: "mr-[5px]" %>Accept
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <% end %>
    <% else %>
      <div class="border border-dashed border-line rounded-[11px] px-[26px] py-12 flex flex-col items-center text-center bg-surface-2">
        <div class="w-[48px] h-[48px] border-[1.5px] border-line rounded-[11px] flex items-center justify-center text-faint bg-surface mb-4"><%= mi "smart_toy", size: 24 %></div>
        <h3 class="m-0 text-[16px] font-semibold text-ink">No proposals</h3>
        <p class="mt-2 mb-0 text-[14px] text-mut max-w-[360px] leading-[1.5]">Values pushed via <span class="font-mono text-ink-2">lb push</span> land here for review before anything goes live.</p>
      </div>
    <% end %>
  </div>
</div>
